{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/callva-io/harness-runner/profile.schema.json",
  "title": "callva-harness-runner profile",
  "description": "How one headless harness turn is run: a flat set of explicit knobs. What each knob does on each harness is documented on the Profile class and in the README. A knob one harness cannot honour is refused for it when the profile is built.",
  "type": "object",
  "additionalProperties": false,
  "required": ["harness"],
  "properties": {
    "harness": {"type": "string", "enum": ["claude", "codex"]},
    "cli_path": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "thinking": {"type": ["boolean", "null"]},
    "max_turns": {"type": ["integer", "null"], "minimum": 1},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "budget_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "tools": {"type": ["array", "null"], "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "disallowed_tools": {"type": "array", "items": {"type": "string"}},
    "permission_mode": {"type": ["string", "null"], "enum": [null, "default", "acceptEdits", "plan", "dontAsk", "auto", "bypassPermissions"]},
    "setting_sources": {"type": ["array", "null"], "items": {"type": "string", "enum": ["user", "project", "local"]}},
    "settings": {"type": ["object", "string", "null"]},
    "mcp_config": {"type": ["object", "string", "null"]},
    "strict_mcp": {"type": "boolean"},
    "add_dirs": {"type": "array", "items": {"type": "string"}},
    "system_prompt": {"type": ["string", "null"]},
    "append_system_prompt": {"type": ["string", "null"]},
    "output_schema": {"type": ["object", "null"]},
    "name": {"type": ["string", "null"]},
    "persist_session": {"type": "boolean"},
    "env_set": {"type": "object", "additionalProperties": {"type": "string"}},
    "env_remove": {"type": "array", "items": {"type": "string"}},
    "strip_session_markers": {"type": "boolean"},
    "codex_config": {"type": ["object", "null"]},
    "approval_policy": {"type": ["string", "null"], "enum": [null, "never", "auto_review"]},
    "service_tier": {"type": ["string", "null"]},
    "bypass_hook_trust": {"type": "boolean"},
    "claude_extra_args": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "codex_extra_args": {"type": "array", "items": {"type": "string"}}
  }
}
